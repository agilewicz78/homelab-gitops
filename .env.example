# Adres helpdesku dostępny z komputera uruchamiającego testy
HELPDESK_URL=https://helpdesk.lab.local

# Konto testowe/admin do testów. Nie commituj prawdziwych haseł.
HELPDESK_ADMIN_EMAIL=admin@example.local
HELPDESK_ADMIN_PASSWORD=change-me

# Dla labowego CA/self-signed TLS ustaw 1
HELPDESK_IGNORE_TLS=1
